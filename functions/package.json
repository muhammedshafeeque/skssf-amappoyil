{
  "name": "skamp-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "emulators": "npm run build && firebase emulators:start --project demo-skamp",
    "test:emulators": "npm run build && firebase emulators:exec --project demo-skamp --only auth,firestore,functions,storage \"npm run test:int\""
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.12",
    "firebase": "^11.10.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
