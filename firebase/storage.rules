rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.role != null; }
    function isAdmin() { return signedIn() && request.auth.token.role in ['super_admin', 'admin']; }
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /members/{memberId}/{file} {
      allow read: if signedIn();
      allow write: if isAdmin() && (request.resource == null || isImage());
    }
    match /committee/{file} {
      allow read: if signedIn();
      allow write: if isAdmin() && (request.resource == null || isImage());
    }
    match /posts/{postId}/{file} {
      allow read: if signedIn();
      allow write: if isAdmin() && (request.resource == null || isImage());
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
